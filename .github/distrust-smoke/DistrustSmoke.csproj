<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Smoke test for the distrusted-intermediate check. Each target framework makes the SDK load a different build:
      net8.0 -> net8.0, net6.0 -> netstandard2.0, net48 -> net462, net452 -> net35.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net6.0;net48;net452</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Twilio/Twilio.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
